# ===========================================================================
# Variables de entorno - Bot de recordatorios por WhatsApp para ejecutivos
# Copia este archivo como .env.local y completa los valores reales.
# ===========================================================================

# --- IA: extracción de intención (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- IA: transcripción de audio (Groq / whisper-large-v3) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgresql://usuario:password@host:5432/bot_ejecutivos

# --- WhatsApp Cloud API (Meta Graph API) ---
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=mi_token_de_verificacion_secreto

# --- Seguridad del endpoint de cron ---
CRON_SECRET=un_secreto_largo_y_aleatorio

# --- URL pública de la app (para callbacks/links) ---
APP_URL=https://tu-dominio.com

# --- NextAuth (panel interno de gestión) ---
# Genera el secreto con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia_esto_por_un_secreto_largo_aleatorio
NEXTAUTH_URL=http://localhost:3000

# Para crear el primer admin con `npm run seed:admin` (opcional, también
# puedes pasar email/password como argumentos del script):
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=cambia_esta_clave
